{
    "name": "2025-11-battle-of-fell-desert-logic",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./a-star-search": {
            "types": "./build/aStarSearch/index.d.ts",
            "import": "./build/aStarSearch/index.js"
        },
        "./affiliation": {
            "types": "./build/affiliation/index.d.ts",
            "import": "./build/affiliation/index.js"
        },
        "./campaign": {
            "types": "./build/campaign/index.d.ts",
            "import": "./build/campaign/index.js"
        },
        "./coordinate-map": {
            "types": "./build/coordinateMap/index.d.ts",
            "import": "./build/coordinateMap/index.js"
        },
        "./degrees-of-success": {
            "types": "./build/degreesOfSuccess/index.d.ts",
            "import": "./build/degreesOfSuccess/index.js"
        },
        "./localization": {
            "types": "./build/localization/index.d.ts",
            "import": "./build/localization/index.js"
        },
        "./mission": {
            "types": "./build/mission/index.d.ts",
            "import": "./build/mission/index.js"
        },
        "./movie": {
            "types": "./build/movie/index.d.ts",
            "import": "./build/movie/index.js"
        },
        "./priority-queue": {
            "types": "./build/priorityQueue/index.d.ts",
            "import": "./build/priorityQueue/index.js"
        },
        "./proficiency": {
            "types": "./build/proficiency/index.d.ts",
            "import": "./build/proficiency/index.js"
        },
        "./resource": {
            "types": "./build/resource/index.d.ts",
            "import": "./build/resource/index.js"
        },
        "./squad": {
            "types": "./build/squad/index.d.ts",
            "import": "./build/squad/index.js"
        },
        "./squaddie": {
            "types": "./build/squaddie/index.d.ts",
            "import": "./build/squaddie/index.js"
        },
        "./squaddie-action": {
            "types": "./build/squaddieAction/index.d.ts",
            "import": "./build/squaddieAction/index.js"
        },
        "./squaddie-item": {
            "types": "./build/squaddieItem/index.d.ts",
            "import": "./build/squaddieItem/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "vite",
        "format-check": "prettier --config .prettierrc.yaml --check .",
        "format-fix": "prettier --config .prettierrc.yaml --write .",
        "clean": "rm -rf build tsconfig.tsbuildinfo",
        "generate-barrels": "node scripts/generateDomainBarrels.mjs",
        "build": "npm run clean && tsc && vite build",
        "preview": "vite preview",
        "tsc": "npx tsc --noEmit 2>&1 | head -10",
        "test": "vitest run",
        "test-watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "prettier-ts": "^1.17.1-2",
        "typescript": "^5.9.3",
        "vite": "^7.1.7",
        "vitest": "^4.0.15"
    },
    "dependencies": {
        "node": "^25.1.0",
        "prettier": "^3.6.2",
        "zod": "^4.4.3"
    }
}
